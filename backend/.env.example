# ============================================================
# International Tijarat - Backend Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values below
#   3. NEVER commit the actual .env file to version control
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
NODE_ENV=development
PORT=3001
UPLOAD_URL=http://localhost:3001

# ----------------------------------------------------------
# Database (MongoDB)
# ----------------------------------------------------------
# Local development (default):
MONGODB_URI=mongodb://127.0.0.1:27017/internationaltijarat

# MongoDB Atlas (production) - replace with your Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ----------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------
# Generate a strong random secret (minimum 32 characters):
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-chars

# Session secret (also generate a strong random value):
SESSION_SECRET=your-super-secure-session-secret-key

# ----------------------------------------------------------
# CORS Settings
# ----------------------------------------------------------
CLIENT_URL=http://localhost:3000,http://localhost:5173
ADMIN_URL=http://localhost:3000

# ----------------------------------------------------------
# Security Settings
# ----------------------------------------------------------
BCRYPT_ROUNDS=10
MAX_FILE_SIZE=5242880

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------
# Redis Cache (optional — falls back to in-memory cache)
# ----------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# ----------------------------------------------------------
# Email Configuration (optional)
# ----------------------------------------------------------
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password
# EMAIL_FROM=International Tijarat <noreply@yourdomain.com>

# ----------------------------------------------------------
# Cache TTL Settings (in seconds)
# ----------------------------------------------------------
# CACHE_TTL_PRODUCTS=300
# CACHE_TTL_CATEGORIES=1800
# CACHE_TTL_PRODUCT_DETAIL=1800

