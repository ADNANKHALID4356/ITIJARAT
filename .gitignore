# ============================================================
# International Tijarat - MERN Stack Project .gitignore
# Professional GitHub-ready configuration
# ============================================================

# ----------------------------------------------------------
# ENVIRONMENT & SECRETS (NEVER COMMIT THESE)
# ----------------------------------------------------------
.env
.env.*
!.env.example
!.env.template.example

# Backend specific env files
backend/.env
backend/.env.*
!backend/.env.example

# Frontend specific env files
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development
frontend/.env.production
!frontend/.env.example

# ----------------------------------------------------------
# DEPENDENCIES
# ----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js

# ----------------------------------------------------------
# BUILD OUTPUTS
# ----------------------------------------------------------
dist/
build/
frontend/dist/
frontend/build/
backend/dist/
frontend/dist-ssr/
*.tgz
*.tar.gz

# ----------------------------------------------------------
# LOGS
# ----------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------------------------
# UPLOADED USER CONTENT (binary blobs, managed separately)
# ----------------------------------------------------------
backend/uploads/
uploads/
public/uploads/
# Keep the uploads directory itself in repo
!backend/uploads/.gitkeep

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.rdb
backend/database-backup/

# ----------------------------------------------------------
# CACHE & TEMPORARY FILES
# ----------------------------------------------------------
.cache/
.parcel-cache/
.tmp/
.temp/
tmp/
temp/
*.tmp
*.temp

# ----------------------------------------------------------
# TESTING & COVERAGE
# ----------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ----------------------------------------------------------
# SSL CERTIFICATES & KEYS
# ----------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer

# ----------------------------------------------------------
# PROCESS MANAGERS
# ----------------------------------------------------------
ecosystem.config.js
pm2.config.js
*.pid
*.seed
*.pid.lock

# ----------------------------------------------------------
# IDE & EDITOR FILES
# ----------------------------------------------------------
.vscode/settings.json
.vscode/*.code-snippets
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# Allow shared VSCode extension recommendations
!.vscode/extensions.json
!.vscode/launch.json

# ----------------------------------------------------------
# OPERATING SYSTEM FILES
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----------------------------------------------------------
# RUNTIME DATA
# ----------------------------------------------------------
pids/

# ----------------------------------------------------------
# DEBUG FILES
# ----------------------------------------------------------
debug*.js
debug*.html
*.debug.js

# ----------------------------------------------------------
# OPTIONAL / MISC
# ----------------------------------------------------------
.yarn-integrity
.node_repl_history
.npm
jspm_packages/
.vscode-test
.eslintcache
*.tsbuildinfo
