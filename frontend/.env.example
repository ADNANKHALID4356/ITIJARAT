# ============================================================
# International Tijarat - Frontend Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. For local development, copy to .env.development:
#      cp .env.example .env.development
#   2. For production, copy to .env.production:
#      cp .env.example .env.production  (then update URLs)
#   3. All Vite env vars MUST start with VITE_ to be exposed
#   4. NEVER commit the actual .env.* files to version control
# ============================================================

# ----------------------------------------------------------
# API Configuration
# ----------------------------------------------------------
# Local development:
VITE_API_BASE_URL=http://localhost:3001/api

# Production (update with your deployed backend URL):
# VITE_API_BASE_URL=https://your-domain.com/api
# VITE_API_URL=https://your-domain.com/api
# VITE_ADMIN_URL=https://your-domain.com/api/admin
# VITE_UPLOADS_URL=https://your-domain.com/uploads

# ----------------------------------------------------------
# App Metadata
# ----------------------------------------------------------
VITE_APP_NAME=International Tijarat
VITE_APP_VERSION=1.0.0

# ----------------------------------------------------------
# API Timeouts (in milliseconds)
# ----------------------------------------------------------
# VITE_API_TIMEOUT=15000
# VITE_UPLOAD_TIMEOUT=30000

# ----------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_REPORTING=false

# ----------------------------------------------------------
# CDN (optional — for static assets in production)
# ----------------------------------------------------------
# VITE_CDN_URL=https://cdn.yourdomain.com

